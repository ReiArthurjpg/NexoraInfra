# ==============================================================================
# Nexora — Variáveis de Ambiente (Template)
# ==============================================================================
# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# DATABASE (MySQL 8.0 — compartilhado entre AuthNexora e IANexora)
# ==============================================================================
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword

# ==============================================================================
# PHPMYADMIN
# ==============================================================================
PHPMYADMIN_PORT=8081

# ==============================================================================
# AUTH NEXORA — API de Autenticação
# ==============================================================================
AUTH_WEB_PORT=8080
AUTH_DB_DATABASE=authnexora
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=rootpassword
AUTH_APP_BASE_URL=http://localhost:8080
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_FRONTEND_RESET_URL=http://localhost:3000/reset-password/guest/reset-password

# JWT
AUTH_JWT_SECRET=change-me
AUTH_JWT_ISSUER=authnexora-api
AUTH_JWT_EXPIRES_IN=3600

# Email (SMTP)
AUTH_MAIL_HOST=smtp.gmail.com
AUTH_MAIL_PORT=465
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_FROM_EMAIL=
AUTH_MAIL_FROM_NAME=Nexora

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ==============================================================================
# IA NEXORA — API de Chat com IA
# ==============================================================================
IA_WEB_PORT=8082
IA_DB_DATABASE=ai_knowledge_base
IA_DB_USERNAME=root
IA_DB_PASSWORD=rootpassword

# URLs de integração
IA_AUTH_API_URL=http://authnexora-web
IA_BRAIN_API_URL=http://brainnexora-web
IA_APP_URL=http://localhost:8082
IA_APP_FRONTEND_URL=http://localhost:3000

# Gemini AI
IA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
IA_GEMINI_API_KEY=
IA_GEMINI_MODEL=gemini-2.5-flash
IA_GEMINI_SYSTEM_PROMPT="Você é o assistente virtual oficial da Nexora BJJ, focado em ajudar usuários a navegar e utilizar a plataforma da melhor maneira possível."

# Uploads
IA_UPLOAD_PATH=storage/uploads
IA_MAX_UPLOAD_SIZE=5242880

# ==============================================================================
# BRAIN NEXORA — API de Busca em Documentação
# ==============================================================================
BRAIN_WEB_PORT=8083
BRAIN_APP_URL=http://localhost:8083
BRAIN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
BRAIN_GEMINI_API_KEY=
BRAIN_GEMINI_MODEL=gemini-2.5-flash
